  "timingNotes": {
    "shotIntervalMs": "milliseconds BETWEEN shots within a burst; null when there is only one shot. Do NOT wait for flight/impact effects to finish before firing the next shot.",
    "durationMs": "target cinematic length; event phases may overlap to fit target length; must ensure last grenade and reveal finish",
    "fireRateShotsPerSecond": "1000 / shotIntervalMs; theoretical instantaneous rate within each burst, not average across grenades",
    "easing": "use animation deltaTime, no blocking sleeps; automatically slow to 1.4x on LOW device FPS only with quality settings",
    "adaptation": "when render overload, reduce particles/shake first; retain number of paid shots and grenade events while allowing abbreviated tracers",
    "speedMultiplierAdmin": {
      "default": 1.0,
      "min": 0.5,
      "max": 2.0,
      "rule": "speed=1/shotInterval; >1 faster. Apply to all intervals and non-hold animation phases, never gift accounting."
    }
  },
