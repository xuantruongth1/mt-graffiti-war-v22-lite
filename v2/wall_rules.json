    "forbidPermanentPaintingOn": [
      "sky",
      "watchtowers",
      "floodlights",
      "railing",
      "ground"
    ],
    "sceneModes": [
      "COMMUNITY_WALL",
      "GIFT_SPOTLIGHT_WALL",
      "TRANSITION",
      "IDLE"
    ],
    "paintLayerOnlyTransition": true,
    "videoReference": "Original example is 480x1040, 59.27s; confirms FPS paint bursts and progressive paint ring; not gift shot counts."
  },
